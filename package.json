{
  "name": "mascii",
  "version": "2.0.0",
  "description": "ASCII terminal music player",
  "main": "index.js",
  "type": "module",
  "bin": {
    "mascii": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "install": "gcc snake_forward_kinematics.c -o snake_anim -lm -O3 || echo '⚠️ Warning: Could not compile native forward kinematics visualizer. Please ensure gcc is installed.'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeetron832/mascii.git"
  },
  "bugs": {
    "url": "https://github.com/coffeetron832/mascii/issues"
  },
  "homepage": "https://github.com/coffeetron832/mascii#readme",
  "keywords": [
    "music",
    "player",
    "terminal",
    "ascii",
    "cli",
    "mpv",
    "youtube"
  ],
  "author": "coffeetron832",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.3.0",
    "colorette": "^2.0.20",
    "music-metadata": "^10.9.1",
    "sharp": "^0.34.5"
  },
  "files": [
    "core/",
    "ui.js",
    "version.js",
    "index.js",
    "snake_forward_kinematics.c"
  ]
}
